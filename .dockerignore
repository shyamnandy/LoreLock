# Keep the build context small and keep secrets out of the daemon.
# The Dockerfile COPYs only requirements.txt, app/ and scripts/, but the
# whole context is uploaded regardless -- data/ alone is ~20 MB.

.git/
.github/
.gitignore

# secrets
.env
.env.*
!.env.example

# the working index -- machine-local and ~16 MB. What ships instead is
# seed/, a public-domain-only copy built from it by scripts/build_seed.py.
data/

# frontend: deployed separately on Vercel
web/

# python
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# not needed to run the API
tests/
docs/
*.md
!README.md
