# Copy to .env and fill in. .env is gitignored; never commit a real key.
# ---------------------------------------------------------------------
# Precedence: real shell environment > .env > built-in default.

# Which provider answers questions.
#   stub | groq | gemini | ollama
# `stub` needs no key and runs the whole graph offline -- the firewall and
# all 35 tests behave identically either way.
LLM_PROVIDER=groq

# https://console.groq.com/keys   (free tier, no card)
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- model routing (optional) ----------------------------------------
# Per-node overrides. Leave unset to use the provider defaults in
# app/config.py. Run `python scripts/models.py` to see live IDs.
#
#   answer -> the reader-facing synthesis; wants instruction-following and
#             the discipline to reply INSUFFICIENT rather than guess
#   fast   -> intent classification + the entailment check; high volume,
#             low difficulty, so a small model is strictly better here
#
# LLM_MODEL_ANSWER=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant
#
# LLM_MODEL=          # blunt override: forces BOTH roles to one model

# --- local ollama ----------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# --- backend deployment ----------------------------------------------
# Where writable state lives. Set to the mounted volume in a container.
# DATA_DIR=/data
# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=https://your-app.vercel.app
