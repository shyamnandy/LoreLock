# Copy to .env and fill in. .env is gitignored; never commit a real key.
# ---------------------------------------------------------------------
# Precedence: real shell environment > .env > built-in default.

# Which provider answers questions.
#   stub | groq | gemini | ollama
# `stub` needs no key and runs the whole graph offline -- the firewall and
# all 35 tests behave identically either way.
LLM_PROVIDER=groq

# https://console.groq.com/keys   (free tier, no card)
#
# Also settable at runtime: the key icon in the app header posts to
# /config/api-key, which verifies the key against the provider and then
# replaces this one in the process environment. The override is PROCESS-WIDE
# -- there is one environment, so a pasted key answers for everyone connected
# -- and it is remembered across restarts (see PERSIST_API_KEY). Clearing it
# from the same dialog falls back to whatever is set here. Leave it blank to
# deploy keyless and have readers supply their own.
#
# Rotating this value invalidates a saved override: the override records a
# fingerprint of the key it replaced, so changing the line below and
# redeploying discards it rather than letting a stale paste shadow the new key.
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- model routing (optional) ----------------------------------------
# Per-node overrides. Leave unset to use the provider defaults in
# app/config.py. Run `python scripts/models.py` to see live IDs.
#
#   answer -> the reader-facing synthesis; wants instruction-following and
#             the discipline to reply INSUFFICIENT rather than guess
#   fast   -> intent classification + the entailment check; high volume,
#             low difficulty, so a small model is strictly better here
#
# Groq defaults: GPT-OSS 120B for answers and 20B for fast checks.
# LLM_MODEL_ANSWER=openai/gpt-oss-120b
# LLM_MODEL_FAST=openai/gpt-oss-20b
#
# LLM_MODEL=          # blunt override: forces BOTH roles to one model

# --- local ollama ----------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# Whether a key pasted from the UI is written to disk (data/db, gitignored
# and dockerignored) and reinstalled on the next boot. On by default, because
# a key that has to be re-pasted after every restart is not persistent in any
# useful sense -- a free instance sleeps after ~15 minutes idle.
#
# Set to 0 on a deployment strangers can reach: there, someone else's
# credential landing on your disk is the greater cost. The key then lasts
# only as long as the process, and the browser that pasted it puts it back.
# PERSIST_API_KEY=1

# --- backend deployment ----------------------------------------------
# Where writable state lives. Set to the mounted volume in a container.
# DATA_DIR=/data
# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=https://your-app.vercel.app
# Gutendex (the Gutenberg catalogue API) answers in <1s from a home
# connection but routinely takes 20-40s from a datacenter IP. Raise the
# budget if source lookups still time out on your host.
# GUTENDEX_TIMEOUT=60
# GUTENDEX_RETRIES=1
# --- embedding memory ------------------------------------------------
# Indexing is the memory high-water mark of the whole app. Defaults are
# sized for a 512 MB instance; raise them on a box with real headroom.
#   EMBED_BATCH    peak RSS over 128 chunks: 4 -> 246 MB, 8 -> 300 MB,
#                  32 -> 632 MB. Drop to 4 if an ingest is still OOM-killed.
#   EMBED_THREADS  ONNX intra-op threads. os.cpu_count() ignores the cgroup
#                  quota, so this must be set explicitly in a container.
#   EMBED_PARALLEL unset = in process. Any int spawns a worker process that
#                  loads a SECOND ~190 MB copy of the model. Faster, but
#                  only set it where that fits.
#
# CPU, not just memory: on a host entitled to less than a full core, more
# ONNX threads buy no parallelism and cost contention plus a second set of
# per-thread arenas. EMBED_THREADS=1 is the right answer there; a laptop
# wants more. render.yaml pins 4/1 for the 512 MB free tier.
# EMBED_BATCH=8
# EMBED_THREADS=2
# EMBED_PARALLEL=
#
# --- indexing vs serving ----------------------------------------------
# Whether this host may BUILD an index or only serve one. Ingesting is
# minutes of pegged CPU and the memory high-water mark of the app, so on a
# small instance -- especially one with no disk, where the result dies on
# the next boot -- it is worth refusing outright. Set to 0 and /books/ingest
# and /books/upload return 503 instead of starting a job the platform will
# kill; the shelf then comes entirely from SEED_DIR below.
# ALLOW_RUNTIME_INGEST=1
#
# --- the index ---------------------------------------------------------
# There is no remote store. The index is files under DATA_DIR: SQLite plus
# one .npy per book. On a host with no persistent disk that directory is
# empty on every boot, so the image ships a prebuilt, public-domain-only
# copy and installs it on a boot that finds nothing (app/store/seed.py).
#
# Rebuild the seed after ingesting something you want deployed:
#     python scripts/build_seed.py     # then commit seed/
#
# Point this elsewhere to use a different prebuilt library, or at a path
# that does not exist to disable seeding entirely -- which is what a host
# with a real mounted disk should do.
# SEED_DIR=/srv/seed

# --- token budget ------------------------------------------------------
# Groq meters tokens per MINUTE and per DAY, separately for each model, and
# the answer call is ~95% of a question's cost. Measured on gpt-oss-120b:
# ~2,750 tokens per answered question, ~1,600 more if the model validator
# runs. Against 8,000 TPM that is ~3 questions a minute; against 200,000 TPD
# it is ~70 a day. Those two numbers are the real ceiling -- the knobs below
# move where you sit under it.
#
# The client paces itself against these limits rather than firing blind and
# handling the 429s: concurrent questions queue for the refill instead of
# failing. Raise it if your account's limit is higher than the free tier's.
# LLM_TPM_LIMIT=8000
#
# The evidence payload IS the cost, and also the answer quality. Passages
# dropped here are passages the model cannot cite, so trim deliberately:
#   tokens_per_question ~= MAX_EVIDENCE_CHARS/4 + 400
# 9000 -> ~2,650   6000 -> ~1,900   4000 -> ~1,400
# MAX_EVIDENCE_CHARS=9000
#
# The model entailment check is a SECOND opinion costing a second call
# (~1,600 tokens). The deterministic citation check -- every cited id must
# be in the evidence set -- is the load-bearing one and always runs, so
# turning this off loses a safety net, not the guarantee.
# VALIDATOR_USE_MODEL=1
#
# Intent is a display badge in the UI: it steers no retrieval and enters no
# prompt. The keyword table in app/agents/analyzer.py resolves most
# questions for free; set to 1 to spend ~240 tokens and ~0.6s per question
# having a model label the remainder more accurately.
# ANALYZER_USE_MODEL=0
